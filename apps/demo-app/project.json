{
    "name": "demo-app",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/demo-app/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "@angular-devkit/build-angular:browser",
            "options": {
                "outputPath": "dist/demo-app",
                "index": "apps/demo-app/src/index.html",
                "main": "apps/demo-app/src/main.ts",
                "polyfills": ["zone.js"],
                "tsConfig": "apps/demo-app/tsconfig.app.json",
                "allowedCommonJsDependencies": [
                    "minimatch",
                    "moment",
                    "@editorjs/code",
                    "@editorjs/editorjs",
                    "@editorjs/header",
                    "@editorjs/inline-code",
                    "@editorjs/list",
                    "@editorjs/marker",
                    "@editorjs/underline",
                    "@quanzo/change-font-size",
                    "cropperjs",
                    "editorjs-html",
                    "editorjs-text-color-plugin",
                    "crypto-js",
                    "inputmask",
                    "chart.js",
                    "pdfjs-dist",
                    "pdfjs-dist/web/pdf_viewer",
                    "utif"
                ],
                "assets": [
                    {
                        "input": "apps/demo-app/assets/images",
                        "output": "/",
                        "glob": "favicon.png"
                    },
                    {
                        "input": "apps/demo-app/assets",
                        "output": "/assets",
                        "glob": "**/*"
                    },
                    {
                        "input": "apps/demo-app/config",
                        "output": "/",
                        "glob": "*.json"
                    },
                    {
                        "input": "apps/demo-app/config",
                        "output": "/",
                        "glob": "*.js"
                    },
                    {
                        "glob": "**/*",
                        "input": "node_modules/@alfresco/adf-core/bundles/assets",
                        "output": "/assets"
                    },
                    {
                        "glob": "**/*",
                        "input": "node_modules/@alfresco/adf-content-services/bundles/assets",
                        "output": "/assets"
                    },
                    {
                        "glob": "pdf.worker.min.js",
                        "input": "node_modules/pdfjs-dist/build",
                        "output": "/"
                    },
                    {
                        "glob": "**/*",
                        "input": "libs/common/assets",
                        "output": "./assets/contezza-common"
                    },
                    {
                        "input": "libs/dynamic-forms/assets",
                        "output": "./assets/dynamic-forms",
                        "glob": "**/*"
                    },
                    {
                        "glob": "extension.schema.json",
                        "input": ".",
                        "output": "./assets"
                    },
                    {
                        "input": "node_modules/@alfresco/aca-content/assets",
                        "output": "/assets",
                        "glob": "**/*"
                    },
                    {
                        "input": "node_modules/@alfresco/aca-content/ms-office/assets",
                        "output": "/assets/ms-office",
                        "glob": "**/*"
                    },
                    {
                        "input": "node_modules/@alfresco/aca-content/ms-office/assets",
                        "output": "/assets/plugins",
                        "glob": "aos.plugin.json"
                    },
                    {
                        "input": "node_modules/@alfresco/aca-content/about/assets",
                        "output": "/assets/plugins",
                        "glob": "about.plugin.json"
                    },
                    {
                        "input": "node_modules/@alfresco/aca-content/folder-rules/assets",
                        "output": "/assets/plugins",
                        "glob": "folder-rules.plugin.json"
                    },
                    {
                        "input": "node_modules/@alfresco/aca-content/folder-rules/assets/i18n",
                        "output": "/assets/folder-rules/i18n",
                        "glob": "**/*"
                    },
                    {
                        "input": "apps/demo-app/assets/extensions",
                        "output": "/assets/plugins",
                        "glob": "**/*.json"
                    },
                    {
                        "glob": "**/*",
                        "input": "apps/demo-app/assets",
                        "output": "./assets/demo-app"
                    },
                    {
                        "input": "node_modules/monaco-editor/min",
                        "output": "./assets/monaco/min",
                        "glob": "**/*"
                    },
                    {
                        "input": "node_modules/monaco-editor/min-maps",
                        "output": "./assets/monaco/min-maps",
                        "glob": "**/*"
                    },
                    {
                        "input": "libs/js-console/assets/extensions",
                        "output": "./assets/plugins",
                        "glob": "*.json"
                    },
                    {
                        "input": "libs/js-console/assets",
                        "output": "./assets/js-console",
                        "glob": "**/*"
                    },
                    {
                        "input": "libs/node-browser/extensions",
                        "output": "./assets/plugins",
                        "glob": "*.json"
                    },
                    {
                        "input": "libs/node-browser/assets",
                        "output": "./assets/node-browser",
                        "glob": "**/*"
                    },
                    {
                        "input": "libs/content-services/assets",
                        "output": "./assets/content-services",
                        "glob": "**/*"
                    },
                    {
                        "input": "libs/content-services/assets/extensions",
                        "output": "./assets/plugins",
                        "glob": "**/*.json"
                    },
                    {
                        "input": "libs/content-services/presets/assets",
                        "output": "./assets/content-services/presets",
                        "glob": "**/*"
                    },
                    {
                        "input": "libs/content-services/presets/assets/extensions",
                        "output": "./assets/plugins",
                        "glob": "**/*.json"
                    },
                    {
                        "input": "libs/content-services/search/assets",
                        "output": "./assets/content-services/search",
                        "glob": "**/*"
                    },
                    {
                        "input": "libs/content-services/search/assets/extensions",
                        "output": "./assets/plugins",
                        "glob": "**/*.json"
                    },
                    {
                        "input": "libs/process-services/assets",
                        "output": "./assets/process-services",
                        "glob": "**/*"
                    },
                    {
                        "input": "libs/process-services/assets/extensions",
                        "output": "./assets/plugins",
                        "glob": "**/*.json"
                    }
                ],
                "inlineStyleLanguage": "scss",
                "stylePreprocessorOptions": {
                    "includePaths": ["node_modules", "node_modules/@alfresco/adf-core/lib", "node_modules/@alfresco/aca-content/ui", "libs/core/ui/mixins"]
                },
                "styles": [
                    "node_modules/cropperjs/dist/cropper.min.css",
                    "node_modules/pdfjs-dist/web/pdf_viewer.css",
                    "libs/dynamic-forms/src/lib/ui/dynamic-forms.theme.scss",
                    "libs/common/src/lib/ui/contezza-style-fixes.scss",
                    "apps/demo-app/src/styles.scss"
                ],
                "scripts": ["node_modules/pdfjs-dist/build/pdf.js", "node_modules/pdfjs-dist/web/pdf_viewer.js", "node_modules/moment/min/moment.min.js"],
                "buildOptimizer": false,
                "optimization": false,
                "vendorChunk": true,
                "extractLicenses": false,
                "sourceMap": true,
                "namedChunks": true
            },
            "configurations": {
                "development": {
                    "optimization": false,
                    "buildOptimizer": false,
                    "vendorChunk": true,
                    "extractLicenses": false,
                    "sourceMap": true,
                    "namedChunks": true
                },
                "production": {
                    "optimization": true,
                    "outputHashing": "all",
                    "sourceMap": false,
                    "namedChunks": false,
                    "extractLicenses": true,
                    "buildOptimizer": true,
                    "verbose": false,
                    "budgets": [
                        {
                            "type": "bundle",
                            "name": "main",
                            "maximumWarning": "2mb",
                            "maximumError": "5mb"
                        },
                        {
                            "type": "bundle",
                            "name": "vendor",
                            "maximumWarning": "10mb",
                            "maximumError": "15mb"
                        },
                        {
                            "type": "anyComponentStyle",
                            "maximumWarning": "6kb"
                        }
                    ],
                    "fileReplacements": [
                        {
                            "replace": "apps/demo-app/src/environments/environment.ts",
                            "with": "apps/demo-app/src/environments/environment.prod.ts"
                        }
                    ]
                }
            },
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "development"
        },
        "serve": {
            "executor": "@angular-devkit/build-angular:dev-server",
            "options": {
                "host": "0.0.0.0",
                "port": 4200,
                "open": true,
                "proxyConfig": "apps/demo-app/proxy.conf.js"
            },
            "configurations": {
                "production": {
                    "buildTarget": "demo-app:build:production"
                },
                "development": {
                    "buildTarget": "demo-app:build:development"
                }
            },
            "defaultConfiguration": "development"
        },
        "lint": {
            "executor": "@nx/eslint:lint"
        }
    },
    "tags": ["scope:demo-app", "type:app", "category:demo-app"]
}
