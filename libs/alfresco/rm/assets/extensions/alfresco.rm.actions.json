{
    "$id": "alfresco.rm.actions",
    "$version": "@@project.version@@",
    "$name": "Contezza Alfresco Record Management Actions",
    "$vendor": "Contezza BV",

    "templates": {
        "actions": [
            {
                "id": "alfresco.rm.actions.readRmauditlog",
                "title": "ALFRESCO.RM.ACTIONS.READ_RMAUDITLOG",
                "icon": "alfresco.rm:text_box_search_outline",
                "actions": {
                    "click": "[ALFRESCO.RM] READ_RMAUDITLOG"
                },
                "rules": {
                    "visible": "alfresco.rm.rules.canReadRmauditlog"
                }
            },
            {
                "id": "alfresco.rm.actions.showAuditlogDetails",
                "title": "ALFRESCO.RM.ACTIONS.SHOW_AUDITLOG_DETAILS",
                "icon": "alfresco.rm:text_box_search_outline",
                "actions": {
                    "click": "[ALFRESCO.RM] SHOW_AUDITLOG_DETAILS"
                },
                "rules": {
                    "visible": "app.selection.single"
                }
            }
        ]
    },

    "features": {
        "rmAuditlog": {
            "contextMenu": [
                {
                    "id": "alfresco.rm.contextMenu.showAuditlogDetails",
                    "imports": "templates.actions[alfresco.rm.actions.showAuditlogDetails]"
                }
            ],
            "toolbar": [
                {
                    "id": "alfresco.rm.contextMenu.showAuditlogDetails",
                    "imports": "templates.actions[alfresco.rm.actions.showAuditlogDetails]"
                },
                {
                    "id": "search.download-results.download-as",
                    "imports": "templates.actions[search.download-results.download-as]"
                }
            ]
        },
        "contextMenu": [
            {
                "id": "alfresco.rm.contextMenu.readRmauditlog",
                "imports": "templates.actions[alfresco.rm.actions.readRmauditlog]"
            }
        ],
        "toolbar": [],
        "viewer": {}
    }
}
