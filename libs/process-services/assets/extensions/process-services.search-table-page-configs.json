{
    "$id": "process-services.search-table-page-configs",
    "$version": "@@project.version@@",
    "$name": "Process Services Search Table Page Configs",
    "$vendor": "Contezza BV",

    "features": {
        "searchTablePageConfigs": [
            {
                "id": "process-services.search-table-page-config.task-instances",
                "title": "PROCESS_SERVICES.BROWSE.TASK_INSTANCES.TITLE",
                "actionContext": { "target": "search-table-page.process-services-tasks" },
                "preferencesId": "process-services-tasks",
                "preferences": ["columns", "sorting", "maxItems"],
                "actions": {
                    "dblclick": "[CORE] NAVIGATE_TO",
                    "contextmenu": "CONTEXT_MENU"
                },
                "featureKeys": {
                    "toolbar": "process-services-tasks-toolbar"
                },
                "searchStrategyId": "process-services.search-strategy.task-instances",
                "columnsId": "process-services.columns.task-instances",
                "default": {
                    "sorting": { "type": "FIELD", "field": "created", "ascending": true },
                    "paging": { "maxItems": 10 }
                },
                "emptyContent": {
                    "icon": "search",
                    "title": "PROCESS_SERVICES.BROWSE.TASK_INSTANCES.EMPTY_STATE.TITLE",
                    "subtitle": "PROCESS_SERVICES.BROWSE.TASK_INSTANCES.EMPTY_STATE.TEXT"
                },
                "currentFolder": {
                    "type": "userProfile",
                    "dynamic-source": "id"
                }
            },
            {
                "id": "process-services-workflows-config",
                "title": "APP.PROCESS.MY_WORKFLOWS.TITLE",
                "actionContext": { "target": "search-table-page.process-services-workflows" },
                "preferencesId": "process-services-workflows",
                "preferences": ["columns", "sorting", "maxItems", "sidebar-filters"],
                "actions": {
                    "click": "dblClickIfMobile",
                    "dblclick": "[PROCESS_SERVICES] NAVIGATE_TO_WORKFLOW_DETAILS",
                    "contextmenu": "[PROCESS_SERVICES] CONTEXT_MENU"
                },
                "featureKeys": {
                    "toolbar": "process-services-workflows-toolbar"
                },
                "searchStrategyId": "process-services.workflows",
                "columnsId": "app.columns.process-services-workflows",
                "sidebarFiltersId": "app.sidebar-filters-process-services-workflows",
                "default": {
                    "sorting": { "type": "FIELD", "field": "started", "ascending": true },
                    "paging": { "maxItems": 10 }
                },
                "emptyContent": {
                    "icon": "search",
                    "title": "APP.PROCESS.MY_WORKFLOWS.EMPTY_CONTENT.TITLE",
                    "subtitle": "APP.PROCESS.MY_WORKFLOWS.EMPTY_CONTENT.SUBTITLE"
                }
            }
        ]
    }
}
