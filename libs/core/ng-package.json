{
    "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
    "dest": "../../dist/@contezza/core",
    "lib": {
        "entryFile": "src/index.ts"
    },
    "allowedNonPeerDependencies": ["@ngrx/component-store", "@ncstate/sat-popover"],
    "assets": [
        {
            "glob": "**/*",
            "input": "./ui",
            "output": "/ui/"
        },
        {
            "glob": "responsive.theme.scss",
            "input": "./responsive/src/lib/ui",
            "output": "/responsive/ui/"
        }
    ]
}
