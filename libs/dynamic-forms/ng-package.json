{
    "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
    "dest": "../../dist/@contezza/dynamic-forms",
    "lib": {
        "entryFile": "src/index.ts"
    },
    "allowedNonPeerDependencies": ["@ngrx/component-store", "@ngneat/input-mask", "inputmask"],
    "assets": [
        {
            "glob": "i18n/*.json",
            "input": "./assets",
            "output": "/assets/"
        },
        {
            "glob": "**/*",
            "input": "./src/lib/ui",
            "output": "/ui/"
        }
    ]
}
