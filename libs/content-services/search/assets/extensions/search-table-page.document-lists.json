        "searchTablePageConfigs": [
            {
                "id": "libraries-config",
                "title": "APP.BROWSE.LIBRARIES.TITLE",
                "columnsId": "libraries.columns",
                "actionContext": { "target": "search-table-page.libraries" },
                "preferencesId": "libraries",
                "preferences": ["columns", "sorting", "maxItems"],
                "queryParams": ["header-filters", "skipCount"],
                "actions": {
                    "dblclick": "[CORE] NAVIGATE_TO_LIBRARY",
                    "contextmenu": "CONTEXT_MENU"
                },
                "searchStrategyId": "sites",
                "default": {
                    "sorting": {
                        "field": "title",
                        "ascending": true
                    }
                },
                "headerFiltersId": "input-form",
                "emptyContent": {
                    "icon": "folder",
                    "title": "APP.BROWSE.LIBRARIES.EMPTY_STATE.FILE_LIBRARIES.TITLE",
                    "subtitle": "APP.BROWSE.LIBRARIES.EMPTY_STATE.FILE_LIBRARIES.TEXT"
                }
            },
            {
                "id": "recent-config",
                "title": "APP.BROWSE.RECENT.TITLE",
                "columnsId": "recent.columns",
                "actionContext": { "target": "search-table-page.recent" },
                "preferencesId": "recent",
                "preferences": ["columns", "sorting", "maxItems"],
                "actions": {
                    "dblclick": "[CORE] NAVIGATE_TO",
                    "contextmenu": "CONTEXT_MENU"
                },
                "queryTemplate": {
                    "query": { "query": "${query}", "language": "afts" },
                    "filterQueries": [
                        { "query": "cm:modified:[NOW/DAY-30DAYS TO NOW/DAY+1DAY]" },
                        { "query": "cm:modifier:'admin' OR cm:creator:'admin'" },
                        {
                            "query": "TYPE:\"content\" AND -PNAME:\"0/wiki\" AND -TYPE:\"app:filelink\" AND -TYPE:\"cm:thumbnail\" AND -TYPE:\"cm:failedThumbnail\" AND -TYPE:\"cm:rating\" AND -TYPE:\"dl:dataList\" AND -TYPE:\"dl:todoList\" AND -TYPE:\"dl:issue\" AND -TYPE:\"dl:contact\" AND -TYPE:\"dl:eventAgenda\" AND -TYPE:\"dl:event\" AND -TYPE:\"dl:task\" AND -TYPE:\"dl:simpletask\" AND -TYPE:\"dl:meetingAgenda\" AND -TYPE:\"dl:location\" AND -TYPE:\"fm:topic\" AND -TYPE:\"fm:post\" AND -TYPE:\"ia:calendarEvent\" AND -TYPE:\"lnk:link\""
                        }
                    ],
                    "include": ["path", "properties", "allowableOperations"]
                },
                "emptyContent": {
                    "icon": "access_time",
                    "title": "APP.BROWSE.RECENT.EMPTY_STATE.TITLE",
                    "subtitle": "APP.BROWSE.RECENT.EMPTY_STATE.TEXT"
                }
            },
            {
                "id": "locked-config",
                "title": "CONTENT_SERVICES.SEARCH.BROWSE.LOCKED.TITLE",
                "columnsId": "app.columns.locked",
                "actionContext": { "target": "search-table-page.locked" },
                "preferencesId": "locked",
                "preferences": ["columns", "sorting", "maxItems"],
                "queryParams": ["skipCount"],
                "actions": {
                    "dblclick": "[CORE] NAVIGATE_TO",
                    "contextmenu": "CONTEXT_MENU"
                },
                "emptyContent": {
                    "icon": "folder",
                    "title": "CONTENT_SERVICES.SEARCH.BROWSE.LOCKED.EMPTY_STATE.TITLE",
                    "subtitle": "CONTENT_SERVICES.SEARCH.BROWSE.LOCKED.EMPTY_STATE.SUBTITLE"

                },
                "baseQuery": "ASPECT:\"cm:lockable\" AND (cm:lockType:\"READ_ONLY_LOCK\" OR cm:lockType:\"WRITE_LOCK\")",
                "queryTemplate": {
                    "query": { "query": "${query}", "language": "afts" },
                    "filterQueries": [{ "query": "${baseQuery}" }],
                    "include": ["path", "properties", "allowableOperations", "aspectNames"]
                },
                "headerFiltersId": "lock-filter"
            },
            {
                "id": "favorites-config",
                "title": "APP.BROWSE.FAVORITES.TITLE",
                "columnsId": "favorites.columns",
                "actionContext": { "target": "search-table-page.favorites" },
                "preferencesId": "favorites",
                "preferences": ["columns", "maxItems"],
                "actions": {
                    "dblclick": "[CORE] NAVIGATE_TO",
                    "contextmenu": "CONTEXT_MENU"
                },
                "baseQuery": "(EXISTS(target/file) OR EXISTS(target/folder))",
                "searchStrategyId": "favorites",
                "emptyContent": {
                    "icon": "star_rate",
                    "title": "APP.BROWSE.FAVORITES.EMPTY_STATE.TITLE",
                    "subtitle": "APP.BROWSE.FAVORITES.EMPTY_STATE.TEXT"
                }
            },
            {
                "id": "downloads-config",
                "title": "CONTENT_SERVICES.SEARCH.BROWSE.DOWNLOADS.TITLE",
                "columnsId": "downloads.columns",
                "actionContext": { "target": "search-table-page.downloads" },
                "preferencesId": "downloads",
                "preferences": ["columns", "maxItems"],
                "queryParams": ["skipCount"],
                "actions": {
                    "dblclick": "DOWNLOAD_NODES",
                    "contextmenu": "CONTEXT_MENU"
                },
                "featureKeys": {
                    "floatingButton": ""
                },
                "emptyContent": {
                    "icon": "download",
                    "title": "CONTENT_SERVICES.SEARCH.BROWSE.DOWNLOADS.EMPTY_STATE.TITLE",
                    "subtitle": "CONTENT_SERVICES.SEARCH.BROWSE.DOWNLOADS.EMPTY_STATE.TEXT"
                },
                "queryTemplate": {
                    "query": { "query": "TYPE:\"download:download\"", "language": "afts" },
                    "include": ["path", "properties", "allowableOperations", "aspectNames"]
                }
            },
            {
                "id": "personal-files-config",
                "title": "APP.BROWSE.PERSONAL.TITLE",
                "columnsId": "personal-files.columns",
                "actionContext": { "target": "search-table-page.personal-files" },
                "preferencesId": "personal-files",
                "preferences": ["sidebar-filters", "columns", "sorting", "maxItems"],
                "actions": {
                    "dblclick": "[CORE] NAVIGATE_TO",
                    "contextmenu": "CONTEXT_MENU",
                    "fileUploadComplete": "reload"
                },
                "searchStrategyId": "browse-files",
                "queryParams": ["skipCount"],
                "currentFolder": {
                    "type": "userProfile",
                    "dynamic-source": "id",
                    "filters": [
                        {
                            "id": "map",
                            "parameters": "id=> return id !== 'admin' ? 'PATH:\"/app:company_home/app:user_homes/cm:'+id.replace('@','_x0040_')+'\"' : 'PATH:\"/app:company_home\"'"
                        },
                        "search",
                        {
                            "id": "getValue",
                            "parameters": "0.entry"
                        }
                    ]
                },
                "queryTemplate": {
                    "query": { "query": "${query}", "language": "afts" },
                    "include": ["path", "properties", "allowableOperations", "aspectNames"]
                },
                "sidebarFiltersId": "sidebar-filters"
            },
            {
                "id": "browse-files-config",
                "title": "APP.BROWSE.PERSONAL.TITLE",
                "showBreadcrumb": true,
                "breadcrumbRootFolderRule": "node.aspectNames.includes('cm:ownable')",
                "columnsId": "files.columns",
                "actionContext": { "target": "search-table-page.browse" },
                "preferencesId": "browse-files",
                "preferences": ["sidebar-filters", "columns", "sorting", "maxItems"],
                "queryParams": ["header-filters", "skipCount"],
                "actions": {
                    "dblclick": "[CORE] NAVIGATE_TO",
                    "contextmenu": "CONTEXT_MENU",
                    "breadcrumbNavigate": "[CORE] NAVIGATE_TO",
                    "fileUploadComplete": "reload"
                },
                "searchStrategyId": "browse-files",
                "queryTemplate": {
                    "query": { "query": "${query}", "language": "afts" },
                    "include": ["path", "properties", "allowableOperations", "aspectNames"]
                },
                "sidebarFiltersId": "sidebar-filters",
                "emptyContent": {
                    "icon": "search",
                    "title": "No results",
                    "subtitle": "No results"
                },
                "currentFolder": {
                    "type": "routeParams",
                    "dynamic-source": "folderId",
                    "filters": ["getNodeById"]
                }
            }
        ],
        "dynamicforms": [
            {
                "id": "input-form",
                "form": {
                    "subfields": [
                        {
                            "id": "q",
                            "type": "input",
                            "label": "NODE_SELECTOR.SEARCH",
                            "settings": { "floatLabel": "never" },
                            "query": { "template": "${value}" },
                            "initialValue": "${routeQueryParams->q}"
                        }
                    ]
                }
            }
        ]
    }
}
