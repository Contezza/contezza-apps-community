{
    "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
    "dest": "../../dist/@contezza/content-services",
    "lib": {
        "entryFile": "src/index.ts"
    },
    "allowedNonPeerDependencies": ["@ngrx/component-store"],
    "assets": [
        {
            "input": "./assets",
            "output": "/assets/",
            "glob": "**/*"
        },
        {
            "input": "./presets/assets",
            "output": "/assets/presets/",
            "glob": "**/*"
        },
        {
            "input": "./presets/assets/extensions",
            "output": "/assets/extensions/",
            "glob": "**/*"
        },
        {
            "input": "./search/assets",
            "output": "/assets/search/",
            "glob": "**/*"
        },
        {
            "input": "./search/assets/extensions",
            "output": "/assets/extensions/",
            "glob": "**/*"
        }
    ]
}
