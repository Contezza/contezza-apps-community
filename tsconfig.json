{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "baseUrl": ".",
        "outDir": "./dist/out-tsc",
        "downlevelIteration": true,
        "module": "esnext",
        "target": "es2022",
        "sourceMap": true,
        "inlineSources": true,
        "allowJs": true,
        "declaration": false,
        "moduleResolution": "node",
        "emitDecoratorMetadata": true,
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "newLine": "lf",
        "typeRoots": ["node_modules/@types"],
        "types": ["node"],
        "lib": ["es2022", "dom", "dom.iterable"],
        "importHelpers": true,
        "noUnusedLocals": true,
        "noImplicitReturns": true,
        "removeComments": false,
        "useDefineForClassFields": false,
        "paths": {
            "@contezza/common": ["libs/common/src/index.ts"],

            "@contezza/content-services": ["libs/content-services/src"],
            "@contezza/content-services/components/*": ["libs/content-services/components/*/src"],
            "@contezza/content-services/components/*/shared": ["libs/content-services/components/*/shared/src"],
            "@contezza/content-services/presets": ["libs/content-services/presets/src"],
            "@contezza/content-services/presets/components/*": ["libs/content-services/presets/components/*/src"],
            "@contezza/content-services/presets/shared": ["libs/content-services/presets/shared/src"],
            "@contezza/content-services/search": ["libs/content-services/search/src"],
            "@contezza/content-services/search/components/*": ["libs/content-services/search/components/*/src"],
            "@contezza/content-services/search/page": ["libs/content-services/search/page/src"],
            "@contezza/content-services/search/shared": ["libs/content-services/search/shared/src"],
            "@contezza/content-services/shared": ["libs/content-services/shared/src"],

            "@contezza/core/actions": ["libs/core/actions/src"],
            "@contezza/core/components/*": ["libs/core/components/*/src"],
            "@contezza/core/context": ["libs/core/context/src/index.ts"],
            "@contezza/core/dialogs": ["libs/core/dialogs/src/index.ts"],
            "@contezza/core/directives": ["libs/core/directives/src/index.ts"],
            "@contezza/core/dynamic-component": ["libs/core/dynamic-component/src/index.ts"],
            "@contezza/core/dynamic-component/shared": ["libs/core/dynamic-component/shared/src/index.ts"],
            "@contezza/core/effects-helper": ["libs/core/effects-helper/src/index.ts"],
            "@contezza/core/extensions": ["libs/core/extensions/src/index.ts"],
            "@contezza/core/guards": ["libs/core/guards/src"],
            "@contezza/core/notifications": ["libs/core/notifications/src/index.ts"],
            "@contezza/core/pipes": ["libs/core/pipes/src/index.ts"],
            "@contezza/core/popover": ["libs/core/popover/src/index.ts"],
            "@contezza/core/property-titles": ["libs/core/property-titles/src"],
            "@contezza/core/responsive": ["libs/core/responsive/src"],
            "@contezza/core/responsive/components/*": ["libs/core/responsive/components/*/src"],
            "@contezza/core/services": ["libs/core/services/src/index.ts"],
            "@contezza/core/stores": ["libs/core/stores/src/index.ts"],
            "@contezza/core/translate": ["libs/core/translate/src"],
            "@contezza/core/utils": ["libs/core/utils/src/index.ts"],

            "@contezza/dynamic-forms": ["libs/dynamic-forms/src/index.ts"],
            "@contezza/dynamic-forms/dialog": ["libs/dynamic-forms/dialog/src/index.ts"],
            "@contezza/dynamic-forms/shared": ["libs/dynamic-forms/shared/src/index.ts"],

            "@contezza/js-console": ["libs/mgmt/js-console/src/index.ts"],
            "@contezza/js-console/shared": ["libs/mgmt/js-console/shared/src/index.ts"],

            "@contezza/node-browser": ["libs/mgmt/node-browser/src/index.ts"],
            "@contezza/node-browser/shared": ["libs/mgmt/node-browser/shared/src/index.ts"],

            "@contezza/people-group-picker": ["libs/people-group-picker/src/index.ts"],

            "@contezza/process-services": ["libs/process-services/src"],
            "@contezza/process-services/shared": ["libs/process-services/shared/src"],
            "@contezza/process-services/components/*": ["libs/process-services/components/*/src"],

            "@contezza/search/form": ["libs/search/form/src/index.ts"]
        }
    },
    "exclude": ["node_modules", "tmp"],
    "angularCompilerOptions": {
        "preserveWhitespaces": false,
        "fullTemplateTypeCheck": true,
        "strictInjectionParameters": true,
        "strictTemplates": true
    }
}
