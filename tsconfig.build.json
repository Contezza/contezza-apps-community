{
    "extends": "./tsconfig.base.json",
    "exclude": ["libs/**/test.ts", "**/*.spec.ts"],
    "compilerOptions": {
        "declaration": true,
        "sourceMap": true,
        "inlineSourceMap": true,
        "inlineSources": true,
        "types": [],
        "paths": {
            "@contezza/alfresco/*": ["./dist/@contezza/alfresco/*"],
            "@contezza/alfresco": ["./dist/@contezza/alfresco/index"],

            "@contezza/content-services/*": ["./dist/@contezza/content-services/*"],
            "@contezza/content-services": ["./dist/@contezza/content-services/index"],

            "@contezza/core/*": ["./dist/@contezza/core/*"],
            "@contezza/core": ["./dist/@contezza/core/index"],

            "@contezza/dynamic-forms/*": ["./dist/@contezza/dynamic-forms/*"],
            "@contezza/dynamic-forms": ["./dist/@contezza/dynamic-forms/index"],

            "@contezza/js-console/*": ["./dist/@contezza/js-console/*"],
            "@contezza/js-console": ["./dist/@contezza/js-console/index"],

            "@contezza/layout/*": ["./dist/@contezza/layout/*"],
            "@contezza/layout": ["./dist/@contezza/layout/index"],

            "@contezza/node-browser/*": ["./dist/@contezza/node-browser/*"],
            "@contezza/node-browser": ["./dist/@contezza/node-browser/index"],

            "@contezza/process-services/*": ["./dist/@contezza/process-services/*"],
            "@contezza/process-services": ["./dist/@contezza/process-services/index"],

            "@contezza/profile/*": ["./dist/@contezza/profile/*"],
            "@contezza/profile": ["./dist/@contezza/profile/index"]
        }
    },
    "angularCompilerOptions": {
        "compilationMode": "partial"
    }
}
